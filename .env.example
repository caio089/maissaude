# CuidarSaude — copie para .env.local e preencha. Nunca commite chaves reais.
# Na Vercel, as mesmas chaves precisam existir em Production (e Preview).

# Supabase (público)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Em produção esta URL é obrigatória. Sem ela o link de recuperação de senha não sai.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (servidor). Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Sessão HMAC do painel — só vale em desenvolvimento. Em produção o login usa Auth.
CLINIC_SESSION_SECRET=
# Senha usada só no seed local do Auth (desenvolvimento). Nunca em produção.
CLINIC_DEMO_PASSWORD=

# Asaas — chave $aact_hmlg_ no sandbox ou $aact_prod_ em produção.
# Envie no header access_token. Nunca use prefixo NEXT_PUBLIC_.
# ASAAS_WEBHOOK_TOKEN é o authToken do webhook (32–255 chars), NÃO a API key.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=
ASAAS_USER_AGENT=CuidarSaude/1.0
