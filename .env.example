# CuidarSaude — copie para .env.local e preencha. Nunca commite chaves reais.

# Supabase (público)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (servidor). Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Sessão do painel da clínica (opcional em desenvolvimento)
CLINIC_SESSION_SECRET=

# Asaas — chave $aact_hmlg_ no sandbox ou $aact_prod_ em produção.
# Envie no header access_token. Nunca use prefixo NEXT_PUBLIC_.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=
ASAAS_USER_AGENT=CuidarSaude/1.0
