# ==============================================================================
# CuidarSaude — Guia de Variáveis de Ambiente para Produção e Desenvolvimento
# ==============================================================================
# INSTRUÇÕES:
# 1. Para desenvolvimento local: copie este arquivo para '.env.local' e preencha.
# 2. Para produção (Vercel): adicione estas variáveis no painel da Vercel
#    (Settings -> Environment Variables) para os ambientes "Production" e "Preview".
# 3. NUNCA faça commit de arquivos '.env.local' ou credenciais reais no repositório.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (CLIENT-SIDE / PÚBLICO)
# ------------------------------------------------------------------------------
# URL do projeto no Supabase (ex.: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima / publicável do Supabase (sb_publishable_... ou jwt eyJ...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ATENÇÃO CRÍTICA (PRODUÇÃO):
# Em produção, defina esta variável com a URL canônica com HTTPS (ex.: https://meuapp.com.br).
# NÃO use 'http://localhost:3000' em produção, pois os e-mails de recuperação de senha
# e links de autenticação do paciente apontarão para esta URL.
# Localmente: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE (SERVER-SIDE / PRIVADO)
# ------------------------------------------------------------------------------
# Chave Service Role com permissão de administrador no Supabase.
# Usada EXCLUSIVAMENTE no servidor (rotas de API / webhooks). NUNCA exponha no client.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. AUTENTICAÇÃO E SESSÃO DA CLÍNICA
# ------------------------------------------------------------------------------
# Chave secreta para assinatura HMAC do cookie da sessão da clínica ('cuidar_clinica').
# Em produção, gere uma string aleatória forte de pelo menos 32 caracteres (ex.: openssl rand -hex 32).
CLINIC_SESSION_SECRET=

# Senha usada EXCLUSIVAMENTE para provisionamento do seed local de demonstração.
# Deixe em branco ou não configure em ambiente de produção.
CLINIC_DEMO_PASSWORD=

# ------------------------------------------------------------------------------
# 4. GATEWAY DE PAGAMENTOS (ASAAS)
# ------------------------------------------------------------------------------
# Ambiente da integração:
# - 'sandbox': para testes e homologação (https://sandbox.asaas.com)
# - 'production': para pagamentos reais (https://api.asaas.com)
ASAAS_ENV=sandbox

# Chave de API gerada no painel do Asaas (Menu Integrações -> Chaves de API).
# Sandbox: inicia com '$aact_hmlg_'
# Produção: inicia com '$aact_prod_'
# NUNCA prefixe com NEXT_PUBLIC_.
ASAAS_API_KEY=

# Token de autenticação dos Webhooks do Asaas (Menu Integrações -> Webhooks).
# Deve ser configurado no painel do Asaas com uma string aleatória de 32 a 255 caracteres.
# O webhook rejeita qualquer requisição cujo header 'asaas-access-token' não coincida com este valor.
# NÃO é a ASAAS_API_KEY.
ASAAS_WEBHOOK_TOKEN=

# Identificador da aplicação no User-Agent para rastreamento de chamadas na API Asaas.
ASAAS_USER_AGENT=CuidarSaude/1.0

